---
layout: layouts/base.njk
permalink: /blog/
title: Writing
description: Essays and guides on developer tools, JavaScript, and the people behind the software.
templateClass: tmpl-ledger
eleventyNavigation:
  key: Blog
  order: 2
---
{%- set posts = collections.posts | reverse %}
{%- set years = posts | postYears %}
{%- set firstYear = years[years.length - 1] %}

<header class="page-header">
  <p class="page-header__eyebrow">{{ posts | length }} posts since {{ firstYear }}</p>
  <h1>Writing</h1>
  <p class="page-header__subtitle">JavaScript runtimes, compilers, developer tooling, and engineering leadership.</p>
  <a class="page-header__browse" href="/tags/">Browse by topic <span aria-hidden="true">↗</span></a>
</header>

<section class="writing-start" aria-labelledby="start-here">
  <h2 id="start-here">Start here</h2>
  <ul class="start-list">
    {% for post in collections.posts | selectPosts(homepage.selectedWriting) | head(2) %}
    <li>
      <a href="{{ post.url }}">
        <span class="start-list__label">{% if loop.first %}Understanding the tools{% else %}The people behind them{% endif %}</span>
        <h3>{{ post.data.title }}</h3>
        <p>{{ homepage.summaries[post.fileSlug] or post.data.description }}</p>
      </a>
    </li>
    {% endfor %}
  </ul>
</section>

<nav class="archive-years" aria-label="Browse writing by year">
  <span>All writing</span>
  {% for year in years %}<a href="#y-{{ year }}">{{ year }}</a>{% endfor %}
</nav>

<div class="ledger">
{%- set currentYear = "" %}
{%- for post in posts %}
  {%- set year = post.date | htmlDateString | truncate(4, true, "") %}
  {%- if year != currentYear %}
    {%- if currentYear != "" %}
      </ul>
    </div>
  </section>
    {%- endif %}
    {%- set currentYear = year %}
    {%- set yearCount = 0 %}
    {%- for p in posts %}{% if (p.date | htmlDateString | truncate(4, true, "")) == year %}{% set yearCount = yearCount + 1 %}{% endif %}{% endfor %}
  <section class="ledger__row" aria-labelledby="y-{{ year }}">
    <div class="ledger__key">
      <h2 class="ledger__kicker ledger__kicker--plain" id="y-{{ year }}">{{ year }}</h2>
      <span class="ledger__count">{{ yearCount }} post{% if yearCount != 1 %}s{% endif %}</span>
    </div>
    <div class="ledger__body">
      <ul class="writing-list">
  {%- endif %}
        <li class="writing-list__item">
          <a href="{{ post.url | url }}" class="writing-list__link writing-list__link--tagged">
            <time class="writing-list__date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate | replace(" " + year, "") }}</time>
            <span class="writing-list__text">
              <span class="writing-list__title">{{ post.data.title }}</span>
              {%- if post.data.description %}
              <span class="writing-list__excerpt">{{ post.data.description }}</span>
              {%- endif %}
            </span>
            {%- set displayTags = post.data.tags | filterTagList %}
            {%- if displayTags | length > 0 %}
            <span class="writing-list__tag">{{ displayTags[0] }}</span>
            {%- endif %}
          </a>
        </li>
{%- endfor %}
      </ul>
    </div>
  </section>
</div>

{% include "_includes/layouts/buttondown.njk" %}
