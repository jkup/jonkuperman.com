---
layout: layouts/base.njk
templateClass: tmpl-post
---
<article class="article">
  <header class="article__header">
    <div class="article__meta">
      <time class="article__date" datetime="{{ page.date | htmlDateString }}">
        {{ page.date | readableDate }}
      </time>
      <span class="article__separator">/</span>
      <span class="article__reading-time">{{ content | readingTime }}</span>
    </div>
    <h1 class="article__title">{{ title }}</h1>
    {% if tags %}
    <div class="article__tags">
      {% for tag in tags | filterTagList %}
        {% set tagUrl %}/tags/{{ tag | slug }}/{% endset %}
        <a href="{{ tagUrl | url }}" class="tag-pill">{{ tag }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </header>

  {% set contents = content | articleContents %}
  {% if contents.length %}
  <details class="article-contents">
    <summary>On this page <span>{{ contents.length }} sections</span></summary>
    <nav aria-label="Article contents">
      <ol>{% for heading in contents %}<li><a href="#{{ heading.id }}">{{ heading.label | safe }}</a></li>{% endfor %}</ol>
    </nav>
  </details>
  {% endif %}

  <div class="article__content">
    {{ content | codeSamples | safe }}
  </div>

  {% set related = collections.posts | relatedPosts(page.url, tags, relatedSlugs) %}
  <section class="related-writing" aria-labelledby="keep-reading">
    <div class="related-writing__heading">
      <h2 id="keep-reading">Keep reading</h2>
      <a href="/blog/">All writing <span aria-hidden="true">↗</span></a>
    </div>
    {% if related.length %}
    <nav class="article__nav" aria-label="Related articles">
      {% for post in related %}
      <a href="{{ post.url }}" class="article__nav-link">
        <span class="article__nav-label">{{ (post.data.tags | filterTagList)[0] }}</span>
        <span class="article__nav-title">{{ post.data.title }}</span>
      </a>
      {% endfor %}
    </nav>
    {% endif %}
  </section>
</article>

{% include "./buttondown.njk" %}
