---
permalink: /tags/
layout: layouts/base.njk
title: Topics
---
<div class="wrapper">
  <header class="page-header">
    <p class="page-header__eyebrow">{{ collections.tagList | length }} topics</p>
    <h1>Topics</h1>
    <p class="page-header__subtitle">Explore the tools I work with, the things I’m learning, and life along the way.</p>
  </header>

  <ul class="topic-list">
  {% for tag in collections.tagList %}
    {% set tagUrl %}/tags/{{ tag | slug }}/{% endset %}
    {% set postCount = collections[tag] | length %}
    <li>
      <a href="{{ tagUrl | url }}" class="topic-list__item">
        <span class="topic-list__heading">
          <span class="topic-list__name">{{ tag }}</span>
          <span class="topic-list__count">{{ postCount }} post{% if postCount != 1 %}s{% endif %}</span>
        </span>
        {% if topicDescriptions[tag] %}<span class="topic-list__description">{{ topicDescriptions[tag] }}</span>{% endif %}
      </a>
    </li>
  {% endfor %}
  </ul>
</div>
